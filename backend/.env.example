# Gold Trading Agent - example environment configuration.
# Never commit real credentials. Placeholders only.
#
# Only secrets and machine-specific settings belong here. Strategy, risk and
# execution parameters are kept in the application's validated configuration.
# There is deliberately no setting that enables live-account trading.

# MetaTrader 5 terminal (optional; leave empty to let MT5 locate the installed terminal)
MT5_TERMINAL_PATH=

# MetaTrader 5 DEMO account credentials
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
